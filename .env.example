# Supabase — both values are required for accounts and cross-device sync.
# Without them the app falls back to a seeded local account in the browser.
#
# Vite only exposes variables prefixed VITE_. The Vercel-Supabase integration
# injects SUPABASE_URL / NEXT_PUBLIC_SUPABASE_*, none of which reach a client
# bundle, so these two must be set explicitly in Vercel and in .env.local.
#
# The anon key is public by design and safe in the browser; row level security
# is what protects the data. Never put the service role key in this project.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
